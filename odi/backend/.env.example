# IMPORTANT: copy this file to `.env` and fill in your real keys.
#
#   cp .env.example .env
#
# The real `.env` file MUST be kept out of source control. The repo's
# `.gitignore` is updated in Task 33 to exclude it. Do NOT commit
# real keys to this template.

# Provider selection. Comma-separated `kind:model` entries evaluated
# left to right. Providers whose API key is missing are skipped
# silently with an INFO log, so it is safe to list all three and
# run with whichever subset you have configured.
#
# The chain below is just one example — change model ids to whichever
# you actually want enabled. Leave the env var unset to use the
# default (gemini:gemini-3.5-flash-lite).
# ODIAI_MODEL_CHAIN=gemini:gemini-3.5-flash-lite,openai:gpt-4o-mini,anthropic:claude-haiku-4-5-20251001

# Google Gemini API key. Get one (free) from:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your-real-key-here

# OpenAI API key. Get one from:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=your-real-key-here

# Anthropic API key. Get one from:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-real-key-here
